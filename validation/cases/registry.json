{
  "schemaVersion": 1,
  "hostProtocolVersion": 1,
  "requirements": {
    "HOST-PROTOCOL": {
      "ownerAdr": "ADR-0014",
      "layer": "L0",
      "description": "Versioned page protocol and state machine"
    },
    "HOST-FRESHNESS": {
      "ownerAdr": "ADR-0014",
      "layer": "L0",
      "description": "Per-navigation run identity, nonce, hashes and timestamps"
    },
    "HOST-DISPOSE": {
      "ownerAdr": "ADR-0014",
      "layer": "L4",
      "description": "Document, GPU and listener teardown is observed"
    },
    "HOST-CAPABILITY": {
      "ownerAdr": "ADR-0014",
      "layer": "L3",
      "description": "Adapter, device and WGSL capability fingerprint"
    },
    "HOST-GPU-ERRORS": {
      "ownerAdr": "ADR-0014",
      "layer": "L3",
      "description": "Compilation, error-scope, uncaptured-error and device-loss collection"
    },
    "HOST-READBACK": {
      "ownerAdr": "ADR-0014",
      "layer": "L3",
      "description": "Bounded GPU execution and numeric readback"
    },
    "GEO-ABI-DECODE": {
      "ownerAdr": "ADR-0016",
      "layer": "L3",
      "description": "WGSL raw storage decode matches the frozen OEGPACK V3 record ABI"
    },
    "GEO-BOOTSTRAP-CONSUME": {
      "ownerAdr": "ADR-0016",
      "layer": "L3",
      "description": "A fixed-slot resident geometry record closes into a WebGPU consumer"
    },
    "CAP-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Subgroups required before opaque resource creation"
    },
    "CAP-002": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Required limits preflight without silent lowering"
    },
    "CAP-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Classifier accepts the reported subgroup width range"
    },
    "CAP-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L2",
      "description": "Subgroup size control remains unrequested"
    },
    "CAP-005": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Actual capability and format specialization recorded"
    },
    "QUE-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Fixed macro and microtile dimensions"
    },
    "QUE-002": {
      "ownerAdr": "ADR-0013",
      "layer": "L2",
      "description": "Four byte microtile record stride"
    },
    "QUE-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L2",
      "description": "Aligned sixteen byte counter and layout records"
    },
    "QUE-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Separate twelve byte indirect records"
    },
    "QUE-005": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "All or nothing bounded heap reservation"
    },
    "QUE-006": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Overflow zeros every resolve indirect argument"
    },
    "QUE-007": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Classifier records and indirect arguments close into GPU consumers without CPU visible-list traversal"
    },
    "QUE-008": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Exact rectangular indirect dispatch tails"
    },
    "CLS-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Classifier workgroup is sixteen by sixteen"
    },
    "CLS-002": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Subgroup operations use uniform control flow"
    },
    "CLS-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Coverage uses width independent two word masks"
    },
    "CLS-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Subgroup results aggregate before global reservation"
    },
    "CLS-005": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "At most one reservation per macro and bin"
    },
    "DIAG-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Pre-consumer failures zero all indirect arguments"
    },
    "ID-005": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Material, instance and MeshletWork bin identity agrees"
    },
    "ID-006": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Textureless program identity always uses binding set zero"
    },
    "VIS-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Visibility writes an r8uint shading-bin MRT"
    },
    "VIS-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Depth winner and shading bin belong to the same raster sample"
    },
    "CLS-006": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Initialize, classify, finalize and resolve pass boundaries are explicit"
    },
    "SHADE-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Each opaque hit receives one complete material evaluation"
    },
    "SHADE-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Textured programs use perspective-correct UV and textureSampleGrad"
    },
    "SHADE-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Lit programs fuse direct lighting in the material consumer"
    },
    "SHADE-006": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Output dependencies participate in pipeline identity and resource pruning"
    },
    "SHADE-007": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "The widest executed variant fits the frozen binding budget"
    },
    "OFF-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Inactive bins own no queue work or dispatch"
    },
    "OFF-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Disabled outputs have no bindings, stores or resources"
    },
    "OFF-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Diagnostics-off physically removes claim resources and shader code"
    },
    "DIAG-001": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Production uses only low-frequency error and safety counters"
    },
    "DIAG-002": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Production successful pixels perform no ownership atomics"
    },
    "DIAG-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Consumer identity mismatch invalidates the frame and suppresses the lane"
    },
    "DIAG-005": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Frame invalid never presents partial output"
    },
    "DIAG-006": {
      "ownerAdr": "ADR-0013",
      "layer": "L3",
      "description": "Ownership validation exists only in a diagnostics variant"
    },
    "DIAG-007": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Readback is asynchronous and never controls current-frame construction"
    },
    "LIFE-003": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "In-flight frames retain immutable publication and GPU resource revisions"
    },
    "LIFE-004": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Resize resources retire only after the referencing submission completes"
    },
    "LIFE-RECOVERY": {
      "ownerAdr": "ADR-0013",
      "layer": "L4",
      "description": "Public Renderer re-negotiates a new device and rebuilds the complete CPU scene without old GPU resources"
    }
  },
