  "cases": [
    {
      "id": "protocol-self-test",
      "route": "/src/cases/protocol-self-test/index.html",
      "kind": "orchestration",
      "buildTarget": "host",
      "ownerAdr": "ADR-0014",
      "requirements": ["HOST-PROTOCOL", "HOST-FRESHNESS", "HOST-DISPOSE"],
      "workloadId": "protocol-self-test-v1",
      "profile": "smoke",
      "timeoutMs": 15000,
      "artifacts": ["result", "events"],
      "changedPaths": ["validation/src/host", "validation/src/runner"]
    },
    {
      "id": "webgpu-component",
      "route": "/src/cases/webgpu-component/index.html",
      "kind": "component",
      "buildTarget": "host",
      "ownerAdr": "ADR-0014",
      "requirements": ["HOST-CAPABILITY", "HOST-GPU-ERRORS", "HOST-READBACK"],
      "workloadId": "webgpu-component-v1",
      "profile": "smoke",
      "timeoutMs": 30000,
      "artifacts": ["result", "events", "screenshot"],
      "changedPaths": ["validation/src/cases/webgpu-component", "OEngine/src/gpu"],
      "errorAllowlist": [
        {
          "source": "console:warning",
          "exact": "The powerPreference option is currently ignored when calling requestAdapter() on Windows. See https://crbug.com/369219127",
          "reason": "Chrome stable emits this platform warning while adapter identity is verified from WebGPU evidence.",
          "ownerRequirement": "HOST-CAPABILITY"
        }
