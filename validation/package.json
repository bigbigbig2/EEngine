{
  "name": "oengine-validation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --test tests/*.test.mjs",
    "validate:registry": "node src/runner/validate-registry.mjs",
    "run:protocol": "node src/runner/run-case.mjs protocol-self-test",
    "run:webgpu": "node src/runner/run-case.mjs webgpu-component",
    "run:oegpack-v3": "node src/runner/run-case.mjs oegpack-v3-component",
    "run:virtual-geometry": "node src/runner/run-case.mjs virtual-geometry-component",
    "run:texture-residency": "node src/runner/run-case.mjs texture-residency-component",
    "run:shading-bin": "node src/runner/run-case.mjs shading-bin-component",
    "run:shading-resolve": "node src/runner/run-case.mjs shading-resolve-component",
    "run:sparse-shading-candidate": "node src/runner/run-case.mjs sparse-shading-candidate",
    "run:sparse-shading-production": "node src/runner/run-case.mjs sparse-shading-production",
    "run:virtual-product-production": "node src/runner/run-case.mjs virtual-product-production",
    "run:glb-web-product": "node src/runner/run-case.mjs glb-web-product",
    "run:glb-web-product-portable-pool": "node src/runner/run-case.mjs glb-web-product-portable-pool",
    "run:glb-authored-texture": "node src/runner/run-case.mjs glb-web-product-authored-texture",
    "run:virtual-product-replacement": "node src/runner/run-case.mjs virtual-product-replacement",
    "run:virtual-product-device-loss": "node src/runner/run-case.mjs virtual-product-device-loss",
    "run:virtual-product-offline": "node src/runner/run-case.mjs virtual-product-offline"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@webgpu/types": "0.1.71",
    "playwright-core": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
