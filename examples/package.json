{
  "name": "oengine-examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:examples": "node scripts/check-examples.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "yarn typecheck && yarn check:examples && vite build",
    "build:examples": "vite build",
    "demo:bistro": "vite --config integrated/bistro-texture-compression/vite.config.ts --host 127.0.0.1 --strictPort --open /integrated/bistro-texture-compression/index.html",
    "typecheck:bistro": "tsc --noEmit -p integrated/bistro-texture-compression/tsconfig.json",
    "build:bistro": "vite build --config integrated/bistro-texture-compression/vite.config.ts",
    "demo:dungeon": "vite --config integrated/dungeon-warkarma-texture-compression/vite.config.ts --host 127.0.0.1 --strictPort --open /integrated/dungeon-warkarma-texture-compression/index.html",
    "typecheck:dungeon": "tsc --noEmit -p integrated/dungeon-warkarma-texture-compression/tsconfig.json",
    "build:dungeon": "vite build --config integrated/dungeon-warkarma-texture-compression/vite.config.ts",
    "demo:scgi": "vite --config integrated/surface-cache-gi-lab/vite.config.ts --host 127.0.0.1 --strictPort --open /integrated/surface-cache-gi-lab/index.html",
    "typecheck:scgi": "tsc --noEmit -p integrated/surface-cache-gi-lab/tsconfig.json",
    "build:scgi": "vite build --config integrated/surface-cache-gi-lab/vite.config.ts",
    "demo:hello-cube": "vite --config modules/hello-cube/vite.config.ts --host 127.0.0.1 --strictPort --open /modules/hello-cube/index.html",
    "typecheck:hello-cube": "tsc --noEmit -p modules/hello-cube/tsconfig.json",
    "build:hello-cube": "vite build --config modules/hello-cube/vite.config.ts",
    "demo:hello-hdr-gltf": "vite --config modules/hello-hdr-gltf/vite.config.ts --host 127.0.0.1 --strictPort --open /modules/hello-hdr-gltf/index.html",
    "typecheck:hello-hdr-gltf": "tsc --noEmit -p modules/hello-hdr-gltf/tsconfig.json",
    "build:hello-hdr-gltf": "vite build --config modules/hello-hdr-gltf/vite.config.ts",
    "demo:sky": "vite --config modules/sky-atmosphere/vite.config.ts --host 127.0.0.1 --strictPort --open /modules/sky-atmosphere/index.html",
    "typecheck:sky": "tsc --noEmit -p modules/sky-atmosphere/tsconfig.json",
    "build:sky": "vite build --config modules/sky-atmosphere/vite.config.ts"
  },
  "dependencies": {
    "@tweakpane/core": "^2.0.5",
    "astronomy-engine": "2.1.19",
    "lucide": "^1.54.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "22",
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
