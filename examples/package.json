{
  "name": "oengine-examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:host": "vite --config vite.config.ts --host 127.0.0.1",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "prebuild:storybook": "npm run build",
    "build:storybook": "npm run typecheck:storybook && storybook build -o storybook-static",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "gate:r5-fx01": "node scripts/run-r5-fx01-gate.mjs",
    "gate:r5-fx02": "node scripts/run-r5-fx02-gate.mjs",
    "gate:r5-fx03": "node scripts/run-r5-fx03-gate.mjs",
    "gate:r5-fx04": "node scripts/run-r5-fx04-gate.mjs",
    "gate:r5-fx05": "node scripts/run-r5-fx05-gate.mjs",
    "gate:r5-fx06": "node scripts/run-r5-fx06-gate.mjs",
    "gate:r5-fx06b": "node scripts/run-r5-fx06b-gate.mjs",
    "gate:r5-fx07": "node scripts/run-r5-fx07-gate.mjs",
    "gate:r5-fx08": "node scripts/run-r5-fx08-gate.mjs",
    "generate:benchmark-assets": "node scripts/generate-teapot-benchmark-assets.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@webgpu/types": "^0.1.64",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
