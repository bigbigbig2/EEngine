{
  "name": "oengine-examples",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:host": "vite --config vite.config.ts --host 127.0.0.1",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "prebuild:storybook": "npm run build",
    "build:storybook": "npm run typecheck:storybook && storybook build -o storybook-static",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "test:fixtures": "node ./fixture-smoke.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@webgpu/types": "^0.1.64",
    "playwright": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
