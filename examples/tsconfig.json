{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "r0-observability/**/*.ts",
    "r0-frame-smoke/**/*.ts",
    "r1-compute-hzb/**/*.ts",
    "r2-*/**/*.ts",
    "benchmark-shared/**/*.ts",
    "benchmark-a/**/*.ts",
    "benchmark-b/**/*.ts",
    "benchmark-c/**/*.ts"
  ]
}
