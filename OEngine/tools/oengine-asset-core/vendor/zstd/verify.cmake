file(READ "${CMAKE_CURRENT_LIST_DIR}/source.json" ZSTD_MANIFEST)
string(JSON ZSTD_FILE_COUNT LENGTH "${ZSTD_MANIFEST}" files)
math(EXPR ZSTD_FILE_LAST "${ZSTD_FILE_COUNT} - 1")
foreach(index RANGE ${ZSTD_FILE_LAST})
    string(JSON name MEMBER "${ZSTD_MANIFEST}" files ${index})
    string(JSON expected GET "${ZSTD_MANIFEST}" files "${name}")
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Pinned Zstd source identity mismatch: ${name}")
    endif()
endforeach()
